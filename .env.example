# Postgres connection string (Neon / Supabase / Vercel Postgres)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
# Direct (non-pooled) connection, required by Prisma Migrate on Neon/Supabase
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"
# 32+ random characters. Generate with: openssl rand -base64 48
SESSION_SECRET="replace-me-with-a-long-random-string"
# Credentials for the first administrator created by the seed script
SEED_ADMIN_EMAIL="secretary@example.org"
SEED_ADMIN_PASSWORD="change-this-immediately"

# --- Outgoing email (optional) ---
# The app sends through Gmail when these two are set, and falls back to Resend
# below when only a key is present. With neither, nothing is ever sent and
# reminders stay copy/WhatsApp only.
#
# MAIL_USER is a Gmail address created for the congregation. Sign in to it,
# turn on 2-Step Verification (https://myaccount.google.com/signinoptions/two-step-verification),
# then create an app password (https://myaccount.google.com/apppasswords) and put
# the 16 characters here — never the account's ordinary password, and never in a
# chat or a commit. Vercel allows outbound SMTP on ports 465 and 587.
MAIL_USER="maitama.congregation@gmail.com"
MAIL_APP_PASSWORD="abcd efgh ijkl mnop"
# The name recipients see. The address itself has to be MAIL_USER, because Gmail
# only lets an account send as itself.
MAIL_FROM_NAME="Maitama Congregation"
# A Gmail account may send to about 500 recipients a day, so a congregation-wide
# mailing is fine but several in one day are not.
# Spaces in the app password are removed for you. A variable added in Vercel only
# reaches the app on the next deployment, so redeploy after setting these, then
# press Test the connection on the Email page.
#
# Fallback engine, used only when the Gmail variables above are absent.
# Create a key at https://resend.com/api-keys
RESEND_API_KEY=""
# Verified sender address. Defaults to the Resend test sender, which only
# delivers to your own Resend account — verify a domain before going live.
REMINDER_EMAIL_FROM="Maitama Congregation <reminders@yourdomain.org>"
# Shared secret that authorises the monthly Vercel Cron job. Vercel sends it as
# a Bearer token; the cron route refuses to run without it. Generate with:
# openssl rand -hex 32
CRON_SECRET="replace-me-with-a-long-random-string"

# --- AI announcement drafting (optional) ---
# On Vercel the AI Gateway authenticates by OIDC, so no key is needed there and
# drafting works automatically. For local development, create an AI Gateway API
# key at Vercel -> AI Gateway and set it here.
AI_GATEWAY_API_KEY=""
# Any AI Gateway "provider/model" string. Defaults to openai/gpt-4.1-mini.
# Examples: anthropic/claude-haiku-4.5, google/gemini-2.5-flash
ANNOUNCEMENT_MODEL="openai/gpt-4.1-mini"
