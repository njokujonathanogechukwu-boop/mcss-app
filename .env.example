# Postgres connection string (Neon / Supabase / Vercel Postgres)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
# Direct (non-pooled) connection, required by Prisma Migrate on Neon/Supabase
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"
# 32+ random characters. Generate with: openssl rand -base64 48
SESSION_SECRET="replace-me-with-a-long-random-string"
# Credentials for the first administrator created by the seed script
SEED_ADMIN_EMAIL="secretary@example.org"
SEED_ADMIN_PASSWORD="change-this-immediately"

# --- Outgoing email (optional) ---
# The app sends through Resend's HTTP API. With no key set, nothing is ever sent
# and reminders stay copy/WhatsApp only. Resend is an API rather than a mail
# server, so there is no Google sign-in for a datacenter IP to fall.
#
# Create a key at https://resend.com/api-keys (it starts with re_). Never put it
# in a chat or a commit — add it in Vercel only.
RESEND_API_KEY=""
# The address recipients see mail come from. Until a domain is verified this
# falls back to Resend's test sender (onboarding@resend.dev), which only delivers
# to your own Resend account. Verify a domain at https://resend.com/domains, add
# the DNS records it shows, then set this to an address on that domain.
REMINDER_EMAIL_FROM="Maitama Congregation <reminders@yourdomain.org>"
# The display name used when REMINDER_EMAIL_FROM is not set. Optional.
MAIL_FROM_NAME="Maitama Congregation"
# Resend's free tier sends up to 100 emails a day and 3,000 a month. A single
# congregation-wide mailing can reach the daily cap, so upgrade the plan if you
# also send reminders and update links the same day. A variable added in Vercel
# only reaches the app on the next deployment, so redeploy after setting these,
# then press Test the connection on the Email page.
#
# Shared secret that authorises the monthly Vercel Cron job. Vercel sends it as
# a Bearer token; the cron route refuses to run without it. Generate with:
# openssl rand -hex 32
CRON_SECRET="replace-me-with-a-long-random-string"

# --- AI announcement drafting (optional) ---
# On Vercel the AI Gateway authenticates by OIDC, so no key is needed there and
# drafting works automatically. For local development, create an AI Gateway API
# key at Vercel -> AI Gateway and set it here.
AI_GATEWAY_API_KEY=""
# Any AI Gateway "provider/model" string. Defaults to openai/gpt-4.1-mini.
# Examples: anthropic/claude-haiku-4.5, google/gemini-2.5-flash
ANNOUNCEMENT_MODEL="openai/gpt-4.1-mini"
