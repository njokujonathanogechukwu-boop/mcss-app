// Maitama Congregation Secretary System — data model
// Records here are confidential. Every table holding personal data is
// reachable only through the RBAC layer in src/lib/rbac.ts.

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ---------------------------------------------------------------- enums

enum Role {
  SECRETARY
  COORDINATOR
  ELDER
  SERVANT
  VIEWER
}

enum Gender {
  MALE
  FEMALE
}

enum Appointment {
  PUBLISHER
  MINISTERIAL_SERVANT
  ELDER
}

enum PioneerStatus {
  NONE
  AUXILIARY
  REGULAR
  SPECIAL
}

enum PublisherStatus {
  ACTIVE
  IRREGULAR
  INACTIVE
  DISFELLOWSHIPPED
  DISASSOCIATED
  TRANSFERRED_OUT
  DECEASED
}

// What the body of elders records about a publisher's standing. Kept apart
// from BoeDecision because these matters are confidential and are never part
// of the meeting summary shared with the elders.
enum StandingKind {
  REPROVED
  DISFELLOWSHIPPED
  DISASSOCIATED
  REINSTATED
  RESTRICTION
}

enum SinceKind {
  MOVED_IN
  STARTED_PUBLISHING
}

enum MeetingType {
  MIDWEEK
  WEEKEND
}

enum BookingStatus {
  PENDING
  APPROVED
  DECLINED
  CANCELLED
}

enum DecisionStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  DEFERRED
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  DONE
}

// An announcement the secretary composes (optionally drafted by AI). With
// self-approval there is no separate approver: DRAFT is still being written,
// APPROVED is final and ready to read, ANNOUNCED has been made at a meeting.
enum AnnouncementStatus {
  DRAFT
  APPROVED
  ANNOUNCED
}

enum ReportSource {
  FORM
  MANUAL
  IMPORT
}

// What a publisher's month means. A row that does not exist at all is
// different from NO_REPORT: nothing has been recorded for them yet.
enum ReportOutcome {
  SHARED
  DID_NOT_PREACH
  NO_REPORT
}

// ---------------------------------------------------------------- access

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  name         String
  passwordHash String
  role         Role       @default(VIEWER)
  active       Boolean    @default(true)
  lastLoginAt  DateTime?
  publisherId  String?    @unique
  publisher    Publisher? @relation("UserPublisher", fields: [publisherId], references: [id], onDelete: SetNull)

  submittedReports  ServiceReport[] @relation("ReportSubmitter")
  decidedBookings   HallBooking[]   @relation("BookingDecider")
  recordedTransfers TransferLog[]   @relation("TransferRecorder")
  auditEntries      AuditLog[]
  createdTasks        Task[]         @relation("TaskCreator")
  createdAnnouncements Announcement[] @relation("AnnouncementCreator")
  recordedStandings    StandingRecord[] @relation("StandingRecorder")
  sentMail             OutboundMail[]   @relation("MailSender")
  standingDocuments    StandingDocument[] @relation("StandingDocumentUploader")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  summary   String
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}

// ------------------------------------------------------------ publishers

model ServiceGroup {
  id     String @id @default(cuid())
  number Int    @unique
  name   String

  overseerId  String?
  overseer    Publisher? @relation("GroupOverseer", fields: [overseerId], references: [id], onDelete: SetNull)
  assistantId String?
  assistant   Publisher? @relation("GroupAssistant", fields: [assistantId], references: [id], onDelete: SetNull)

  members      Publisher[]   @relation("GroupMembers")
  transfersOut TransferLog[] @relation("TransferFrom")
  transfersIn  TransferLog[] @relation("TransferTo")

  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Publisher {
  id        String @id @default(cuid())
  firstName String
  lastName  String

  gender      Gender
  dateOfBirth DateTime?
  baptismDate DateTime?
  isBaptized  Boolean   @default(false)
  isAnointed  Boolean   @default(false)

  appointment   Appointment     @default(PUBLISHER)
  pioneerStatus PioneerStatus   @default(NONE)
  status        PublisherStatus @default(ACTIVE)
  privileges    String[]        @default([])

  // When they came onto this congregation's roll: moved in from another
  // congregation, or took up publishing here. Null for publishers already on
  // the books before this was tracked; nothing is expected of a publisher
  // before this date, so reminders and the report sheet skip earlier months.
  sinceDate DateTime?  @db.Date
  sinceKind SinceKind?

  phone                 String?
  email                 String?
  address               String?
  emergencyContactName  String?
  emergencyContactPhone String?

  // Unguessable token behind each publisher's personal "update my details"
  // link. Null until the secretary first copies the link.
  selfToken String? @unique

  groupId String?
  group   ServiceGroup? @relation("GroupMembers", fields: [groupId], references: [id], onDelete: SetNull)

  notes String?

  reports              ServiceReport[]
  transfers            TransferLog[]        @relation("TransferSubject")
  assignedItems        BoeDecision[]        @relation("DecisionAssignee")
  overseesGroups       ServiceGroup[]       @relation("GroupOverseer")
  assistsGroups        ServiceGroup[]       @relation("GroupAssistant")
  userAccount          User?                @relation("UserPublisher")
  privilegeAssignments PublisherPrivilege[] @relation("PublisherPrivileges")
  assignedTasks        Task[]               @relation("TaskAssignee")
  auxApprovals         AuxiliaryPioneer[]   @relation("AuxApprovals")
  standingRecords      StandingRecord[]     @relation("PublisherStanding")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([lastName, firstName])
  @@index([groupId])
  @@index([status])
}

// One row per dated event in a publisher's standing: a reproof, a removal, a
// reinstatement or a restriction. `announcedDate` is the date the announcement
// was read to the congregation, if there was one; `liftedDate` applies only to
// restrictions and stays null while they are still running. A restriction may
// hang off the entry it came from through `parentId`, so the restrictions a
// committee placed are read against that decision rather than as loose events.
model StandingRecord {
  id          String       @id @default(cuid())
  publisherId String
  publisher   Publisher    @relation("PublisherStanding", fields: [publisherId], references: [id], onDelete: Cascade)
  kind        StandingKind

  eventDate     DateTime  @db.Date
  announcedDate DateTime? @db.Date
  liftedDate    DateTime? @db.Date
  notes         String?

  parentId     String?
  parent       StandingRecord?  @relation("StandingRestrictions", fields: [parentId], references: [id], onDelete: Cascade)
  restrictions StandingRecord[] @relation("StandingRestrictions")

  documents StandingDocument[] @relation("StandingCaseDocuments")

  recordedById String?
  recordedBy   User?     @relation("StandingRecorder", fields: [recordedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([publisherId, eventDate])
  @@index([kind])
  @@index([parentId])
}

// A case file's papers: the S-77 itself, a letter requesting reinstatement, a
// letter of introduction, committee notes. Bytes live in the database because
// the platform has no other place to keep them, and the entry owns them.
model StandingDocument {
  id               String         @id @default(cuid())
  standingRecordId String
  standingRecord   StandingRecord @relation("StandingCaseDocuments", fields: [standingRecordId], references: [id], onDelete: Cascade)

  fileName String
  mimeType String
  size     Int
  bytes    Bytes

  uploadedById String?
  uploadedBy   User?   @relation("StandingDocumentUploader", fields: [uploadedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([standingRecordId])
}

model TransferLog {
  id          String    @id @default(cuid())
  publisherId String
  publisher   Publisher @relation("TransferSubject", fields: [publisherId], references: [id], onDelete: Cascade)

  fromGroupId String?
  fromGroup   ServiceGroup? @relation("TransferFrom", fields: [fromGroupId], references: [id], onDelete: SetNull)
  toGroupId   String?
  toGroup     ServiceGroup? @relation("TransferTo", fields: [toGroupId], references: [id], onDelete: SetNull)

  effectiveDate DateTime
  reason        String?
  recordedById  String?
  recordedBy    User?    @relation("TransferRecorder", fields: [recordedById], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())

  @@index([publisherId])
}

// --------------------------------------------------------- field service

// One row per publisher per calendar month.
// Under the current reporting arrangement, publishers who are not pioneers
// report only whether they shared in the ministry plus Bible studies.
// `hours` stays null for them and is never summed into congregation totals.
model ServiceReport {
  id          String    @id @default(cuid())
  publisherId String
  publisher   Publisher @relation(fields: [publisherId], references: [id], onDelete: Cascade)

  year  Int
  month Int

  outcome           ReportOutcome @default(SHARED)
  bibleStudies      Int           @default(0)
  hours             Int?
  creditHours       Int?
  pioneerStatusUsed PioneerStatus @default(NONE)
  remarks           String?

  source        ReportSource @default(MANUAL)
  submittedById String?
  submittedBy   User?        @relation("ReportSubmitter", fields: [submittedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([publisherId, year, month])
  @@index([year, month])
}

// One row per month whose congregation report has been submitted to the
// branch office. Closing a month freezes who had reported on time
// (`onTimeIds`); a report that arrives afterwards for that month is late and
// rolls into the next month's figure. `lateKeys` records the earlier-month
// reports ("publisherId|year|month") already absorbed into this submission so
// they are never counted twice.
model ReportPeriod {
  id            String   @id @default(cuid())
  year          Int
  month         Int
  submittedAt   DateTime @default(now())
  submittedById String?
  onTimeIds     String[] @default([])
  lateKeys      String[] @default([])
  note          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([year, month])
  @@index([year, month])
}

// An approved auxiliary pioneer application. The form states either a number
// of months from the start month or indefinite service; `months` null means
// indefinite until the secretary closes it. Recording an approval also sets
// the publisher's pioneerStatus to AUXILIARY so hours are expected.
model AuxiliaryPioneer {
  id          String    @id @default(cuid())
  publisherId String
  publisher   Publisher @relation("AuxApprovals", fields: [publisherId], references: [id], onDelete: Cascade)

  startYear  Int
  startMonth Int
  months     Int?

  approvedAt  DateTime  @default(now())
  announcedAt DateTime?
  notes       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([publisherId])
  @@index([startYear, startMonth])
}

// ------------------------------------------------------------ attendance

model MeetingAttendance {
  id          String      @id @default(cuid())
  date        DateTime    @db.Date
  meetingType MeetingType
  inPerson    Int         @default(0)
  zoom        Int         @default(0)
  notes       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([date, meetingType])
  @@index([date])
}

// --------------------------------------------------------------- the hall

model HallResource {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?
  capacity    Int?
  active      Boolean @default(true)

  bookings  HallBooking[]
  createdAt DateTime      @default(now())
}

model HallBooking {
  id         String       @id @default(cuid())
  resourceId String
  resource   HallResource @relation(fields: [resourceId], references: [id], onDelete: Restrict)

  requestingBody    String
  contactName       String
  contactPhone      String?
  eventType         String
  startTime         DateTime
  endTime           DateTime
  setupRequirements String?

  status       BookingStatus @default(PENDING)
  decisionNote String?
  decidedById  String?
  decidedBy    User?         @relation("BookingDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([resourceId, startTime, endTime])
  @@index([status])
}

// ----------------------------------------------------------------- elders

model BoeDecision {
  id          String   @id @default(cuid())
  meetingDate DateTime @db.Date
  agendaItem  String
  decision    String

  assignedToId String?
  assignedTo   Publisher? @relation("DecisionAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  targetDate  DateTime?      @db.Date
  status      DecisionStatus @default(OPEN)
  completedAt DateTime?
  notes       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, targetDate])
}

// ----------------------------------------------------- tasks and announcements

// A day-to-day activity or assignment the secretary tracks. Distinct from
// BoeDecision, which records decisions reached at an elders' meeting.
model Task {
  id     String     @id @default(cuid())
  title  String
  detail String?

  status  TaskStatus @default(OPEN)
  dueDate DateTime?  @db.Date

  assigneeId String?
  assignee   Publisher? @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  createdById String?
  createdBy   User?    @relation("TaskCreator", fields: [createdById], references: [id], onDelete: SetNull)

  completedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status, dueDate])
}

model Announcement {
  id    String @id @default(cuid())
  title String
  body  String

  eventDate DateTime?          @db.Date
  status    AnnouncementStatus @default(DRAFT)
  // True when the body was first composed by the AI gateway, so the secretary
  // knows to check it before it is read out.
  aiDrafted Boolean @default(false)

  createdById String?
  createdBy   User?  @relation("AnnouncementCreator", fields: [createdById], references: [id], onDelete: SetNull)

  approvedAt  DateTime?
  announcedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, eventDate])
}

// ----------------------------------------------------- outgoing mail

// A copy of every email the platform sends, so the secretary can see what went
// out, to whom, and whether it was delivered to the mail server. `kind` is one
// of REMINDER, UPDATE_LINK, ANNOUNCEMENT, ACCOUNT or GENERAL.
model OutboundMail {
  id      String  @id @default(cuid())
  to      String
  subject String
  body    String
  kind    String  @default("GENERAL")

  provider String
  ok       Boolean
  error    String?

  sentById String?
  sentBy   User?   @relation("MailSender", fields: [sentById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([kind])
}

// ---------------------------------------------------------------- memorial

model MemorialRecord {
  id        String   @id @default(cuid())
  year      Int      @unique
  date      DateTime @db.Date
  inPerson  Int      @default(0)
  video     Int      @default(0)
  partakers Int      @default(0)
  notes     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ------------------------------------------------ privileges and assignments

enum PrivilegeRole {
  OVERSEER
  ASSISTANT
  SERVANT
  ASSIGNEE
}

enum PrivilegeCategory {
  CONGREGATION
  MEETING
  OTHER
}

model Privilege {
  id          String            @id @default(cuid())
  name        String            @unique
  category    PrivilegeCategory @default(CONGREGATION)
  description String?
  sortOrder   Int               @default(0)
  active      Boolean           @default(true)

  holders PublisherPrivilege[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PublisherPrivilege {
  id          String        @id @default(cuid())
  publisherId String
  publisher   Publisher     @relation("PublisherPrivileges", fields: [publisherId], references: [id], onDelete: Cascade)
  privilegeId String
  privilege   Privilege     @relation(fields: [privilegeId], references: [id], onDelete: Cascade)
  role        PrivilegeRole @default(ASSIGNEE)
  startDate   DateTime?     @db.Date
  endDate     DateTime?     @db.Date
  notes       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([publisherId])
  @@index([privilegeId])
}

// ------------------------------------------------------- official forms

enum FormKind {
  S21
  S1
  S88
}

/// An uploaded official fillable PDF. Exports are written into it when
/// one is on file; otherwise the built-in layout is used.
model FormTemplate {
  id           String   @id @default(cuid())
  kind         FormKind @unique
  fileName     String
  data         Bytes
  fieldCount   Int      @default(0)
  uploadedById String?
  uploadedAt   DateTime @default(now())
}
