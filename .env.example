# Postgres connection string (Neon / Supabase / Vercel Postgres)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
# Direct (non-pooled) connection, required by Prisma Migrate on Neon/Supabase
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"
# 32+ random characters. Generate with: openssl rand -base64 48
SESSION_SECRET="replace-me-with-a-long-random-string"
# Credentials for the first administrator created by the seed script
SEED_ADMIN_EMAIL="secretary@example.org"
SEED_ADMIN_PASSWORD="change-this-immediately"

# --- Outgoing email (optional) ---
# The app sends through Gmail when the four Gmail variables below are all set,
# and falls back to Resend when only RESEND_API_KEY is present. With neither,
# nothing is ever sent and reminders stay copy/WhatsApp only.
#
# Gmail signs in with OAuth2, NOT an app password. Google refuses password
# logins from datacenter IPs (Vercel included) with 534-5.7.9, but accepts an
# OAuth2 token from anywhere — so this is the way to send from a congregation
# Gmail account without buying a domain. Create the values once:
#   1. console.cloud.google.com → create a project → enable the Gmail API.
#   2. OAuth consent screen → External → fill app name + your email → set
#      Publishing status to "In production" (in "Testing" the token dies after
#      7 days, which breaks the monthly reminder cron).
#   3. Credentials → Create credentials → OAuth client ID → Web application →
#      add https://developers.google.com/oauthplayground as a redirect URI.
#      The client ID and secret are GMAIL_CLIENT_ID and GMAIL_CLIENT_SECRET.
#   4. developers.google.com/oauthplayground → gear → "Use your own OAuth
#      credentials" → enter that ID and secret → authorise the scope
#      https://mail.google.com/ signed in as MAIL_USER → "Exchange
#      authorization code for tokens" → copy the refresh_token.
# Never put these in a chat or a commit — add them in Vercel only.
MAIL_USER="maitamasecretary@gmail.com"
GMAIL_CLIENT_ID="000000000000-xxxxxxxxxxxxxxxx.apps.googleusercontent.com"
GMAIL_CLIENT_SECRET="GOCSPX-xxxxxxxxxxxxxxxxxxxx"
GMAIL_REFRESH_TOKEN="1//0gxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# The name recipients see. Gmail only lets an account send as itself, so the
# address is always MAIL_USER.
MAIL_FROM_NAME="Maitama Congregation"
# A Gmail account may send to about 500 recipients a day, so a congregation-wide
# mailing is fine but several in one day are not.
#
# Fallback engine, used only when the Gmail variables above are incomplete.
# Create a key at https://resend.com/api-keys (it starts with re_).
RESEND_API_KEY=""
# Resend's sending address. Until a domain is verified at https://resend.com/domains
# this falls back to Resend's test sender (onboarding@resend.dev), which only
# delivers to your own Resend account. Resend's free tier is 100 emails a day.
REMINDER_EMAIL_FROM="Maitama Congregation <reminders@yourdomain.org>"
# A variable added in Vercel only reaches the app on the next deployment, so
# redeploy after setting these, then press Test the connection on the Email page.
#
# Shared secret that authorises the monthly Vercel Cron job. Vercel sends it as
# a Bearer token; the cron route refuses to run without it. Generate with:
# openssl rand -hex 32
CRON_SECRET="replace-me-with-a-long-random-string"

# --- AI announcement drafting (optional) ---
# On Vercel the AI Gateway authenticates by OIDC, so no key is needed there and
# drafting works automatically. For local development, create an AI Gateway API
# key at Vercel -> AI Gateway and set it here.
AI_GATEWAY_API_KEY=""
# Any AI Gateway "provider/model" string. Defaults to openai/gpt-4.1-mini.
# Examples: anthropic/claude-haiku-4.5, google/gemini-2.5-flash
ANNOUNCEMENT_MODEL="openai/gpt-4.1-mini"
